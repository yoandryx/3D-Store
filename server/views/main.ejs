<!DOCTYPE html>

<html lang="en">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

        <title>LAYERS</title>

        <!-- <base href="/"> -->

        <link rel="stylesheet" href="css/styles.css"/>
        
        <link href="https://api.fontshare.com/v2/css?f[]=panchang@200,300,400,500,600,700,800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

        <script src="../js/three.js-master/build/three.js"></script>
        <script src="../js/three.js-master/examples/js/loaders/GLTFLoader.js"></script>
        <!-- <script src="js/three.js-master/examples/js/controls/OrbitControls.js"></script> -->

        <!-- <script src="https://checkout.stripe.com/checkout.js"></script> -->
        <script src="https://js.stripe.com/v3/"></script>
        <script src="../store.js" defer></script>
        

    </head>


    <body>

        <div class="exp">
            <canvas class="can"><script type="module" src="../js/3dworld.js"></script></canvas>
        </div>

        <section id="loadingScreen">
            
            <div class="loader">
                <span style="--i:0"></span>
                <span style="--i:2"></span>
                <span style="--i:0"></span>
            </div>

            <div class="loading-text">LOADING</div>
            
        </section>

        <div class="page" id="welcome">
            <div class="page-wrapper">

                <div class="second-move first-margin">

                    <div class="welcome">
                        <div class="welcome-text"><h3>WELCOME TO</h3></div>
                    </div>

                    <div class="low">

                        <div class="welcome-main">
                            <span class="material-symbols-outlined">
                                <a href="#product">arrow_forward_ios</a>
                            </span>
                        </div>

                        <div class="welcome-sec">
                            <h6>LAYERS ORIGINAL 3D STORE</h6>
                            <h6>PROVIDING UNIQUE & LIMITED 3D PRINTED ART</h6>
                            <h6>INVITING DIGITAL ART INTO THE PHYSICAL WORLD</h6>
                            <h6>DESIGNED & MANUFACTURED BY LAYERS</h6>
                        </div>

                    </div>

                </div>

                <div class="first-move section-margin"></div>

                <nav class="navbar">
                    <div class="navbar-wrapper">
                     
                        <div id="menu" class="menu-card">
                            <ul class="nav-option-container">
                                 <btn onclick="menuClose()" class="option">
                                    <a href="#product">VASE</a>
                                 </btn>
                                 <btn onclick="menuClose()" class="option">
                                    <a href="#hands">HANDS</a>
                                 </btn>
                                 <btn onclick="menuClose()" class="option">
                                    <a href="#roadmap">ROADMAP</a>
                                 </btn>
                                 <btn onclick="menuClose()" class="option">
                                    <a href="#">ABOUT</a>
                                 </btn>
                             </ul>
                        </div>

                        <btn onclick="menuOpen()" id="bars" class="menu-bars">
                            <span  class="bar1"></span>
                            <span  class="bar2"></span>
                            <span  class="bar3"></span>
                        </btn>
                        
                        <div class="logo">
                            <h6>LAY<div class="flip">E</div>RS</h6>
                        </div>

                        <div class="items">

                            <span class="material-symbols-outlined bitcoin">
                                currency_bitcoin
                            </span>

                            <!-- <span onclick="cartOpen()" class="material-symbols-outlined">
                                shopping_cart
                            </span> -->

                            <btn onclick="cartOpen()" class="cart-btn">

                                <span class="material-symbols-outlined">
                                    shopping_cart
                                </span>

                            </btn>

                        </div>

                        <div id="cart" class="cart-card">

                            <div class="cart-info">

                                <div class="cart-info-wrapper">

                                    <div onclick="cartClose()" class="cart-close">
                                        <span class="material-symbols-outlined">
                                            close
                                        </span>
                                    </div>

                                    <h5 class="cart-title">CART</h5>

                                    <div class="cart-items">
                                    </div>

                                    <div class="empty-cart"> ADD ITEMS</div>

                                    <form class="finalize" action="/purchase" method="POST" id="payment-form">

                                            <div class="cart-total">
                                                <strong class="cart-total-title">TOTAL</strong>
                                                <span class="cart-total-price">$0</span>
                                            </div>

                                            <button class="btn-purchase" type="submit" id="submit">CHECKOUT</button>

                                     </form>

                                </div>
                                

                                

                            </div>

                        </div>

                    </div>

                </nav>
                 
                <div id="vase-pic-holder" class="img-holder">

                    <img id="vase-pic" class="largeImg" src="assets/imgs/closeupVase4.png">

                        <div onclick="imgClose()" id="closeimg" class="imgclose">
                                <span class="material-symbols-outlined">
                                    close
                                </span>
                        </div>

                    </img>

                </div>

                <div id="hands-pic-holder" class="img-holder">

                    <img id="vase-pic" class="largeImg" src="assets/imgs/Handsfinal.png">

                        <div onclick="imgClose()" id="closeimg" class="imgclose">
                                <span class="material-symbols-outlined">
                                    close
                                </span>
                        </div>

                    </img>

                </div>

                <section id="product">
                    <div class="product-wrapper">
        
                        <div id="vase">

                            <btn onclick="vaseCardOpen()" class="vase-info-btn">

                                    <span id="card-switch" class="material-symbols-outlined cross">
                                        scatter_plot
                                    </span>

                            </btn>

                            <div id="vase-card" class="info-card">
                                <div class="card-container">

                                    <div  class="inner-card">
                                        
                                        <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" class="inner-card-container">

                                            <div class="inner-card-description">

                                                <h5>BOOTY VASE COLLECTION</h5>
                                
                                                <h6>-3D PRINTED MULTI-PURPOSE VASE & ART DISPLAY</h6>
                                                <h6>-LIMITED EDITION VASE MADE OF BIODEGRADABLE WOOD INFILLED FILAMENT</h6>
                                                <h6>-FRAMED 3D MODEL DESIGN & UNIQUE 3D PRINTED ART DISPLAY</h6>
                                                
                                            </div>

                                        </div>
                                    
                                    </div>

                                    <% items.Vase.map(item => { %>
                                            <div class="shop-item" data-item-id="<%= item.id %>">

                                                <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" data-tilt-glare data-tilt-max-glare="0.2" class="inner-card-pic">
                                                    <img onclick="expandVaseImg()" class="shop-item-image" src="assets/imgs/<%= item.imgName %>">
                                                </div>
                                                
                                                <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" data-tilt-glare data-tilt-max-glare="0.2" class="shop-item-details">
                                                    <span class="shop-item-title"><h3><%= item.name %></h3></span>
                                                    <span class="shop-item-price"><h6>$<%= item.price / 100 %></h6></span>
                                                </div>

                                                <button class="shop-item-button" id="submit-purchase" type="button"><span class="material-symbols-outlined">shopping_cart</span></button>
                                                
                                            </div>
                                    <% }) %>

                                </div>
                            </div>

                        </div>
        
                        <div class="low">

                            <div class="low-main">
                                <span class="material-symbols-outlined">
                                    <a href="#second-model">arrow_forward_ios</a>
                                </span>
                            </div>
    
                            <div class="low-sec">
                                <h6>3D PRINTED MULTI-PURPOSE VASE & ART DISPLAY.</h6>
                                <h6>EACH VASE IS UNIQUE TO ITSELF MADE BY 3D PRINTING TECHNOLOGY</h6>
                                <h6>- LIMITED COLLECTION -</h6>
                            </div>

                            <div class="vase-title">
                                <h3>THE BOOTY VASE</h3>
                                <h6>MODEL #1 | Limited Edition</h6>
                            </div>

                        </div>

                    </div>
                </section>

                <div class="third-move third-margin"></div>

                <section class="t-move second-product" id="hands">
                    <div class="product-wrapper">
    
                        <div id="second-model">

                            <btn onclick="handCardOpen()" class="second-model-info-btn">
                                <span id="card-switch2" class="material-symbols-outlined">
                                    scatter_plot
                                </span>
                            </btn>

                            <div id="hands-card" class="second-info-card">

                                <div class="card-container">

                                    <div  class="inner-card">
                                        
                                        <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" class="inner-card-container">

                                            <div class="inner-card-description">

                                                <h5>HANDS COLLECTION</h5>
                                
                                                <h6>-FULLY 3D PRINTED MULTI-PURPOSE HAND HOLDER</h6>
                                                <h6>-JOIN AND INVEST IN LAYERS WITH THIS UNIQUE HAND DECOR</h6>
                                                <h6>-RECIEVE A 3D MODEL NFT, VISIT ROADMAP SECTION FOR INFO</h6>
                                                
                                            </div>

                                        </div>
                                    
                                    </div>

                                    <% items.Hands.map(item => { %>
                                            <div class="shop-item" data-item-id="<%= item.id %>">

                                                <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" data-tilt-glare data-tilt-max-glare="0.2" class="inner-card-pic">
                                                    <img onclick="expandHandsImg()" class="shop-item-image" src="assets/imgs/<%= item.imgName %>">
                                                </div>
                                                
                                                <div data-tilt data-tilt-axis="x" data-tilt-reverse="true" data-tilt-glare data-tilt-max-glare="0.2" class="shop-item-details">
                                                    <span class="shop-item-title"><h3><%= item.name %></h3></span>
                                                    <span class="shop-item-price"><h6>$<%= item.price / 100 %></h6></span>
                                                </div>

                                                <button class="shop-item-button" id="submit-purchase" type="button"><span class="material-symbols-outlined">shopping_cart</span></button>
                                                
                                            </div>
                                    <% }) %>

                                </div>
                            </div>

                        </div>

                        <div class="low-3">

                            <div class="welcome-main">
                                <span class="material-symbols-outlined">
                                    <a href="#roadmap">arrow_forward_ios</a>
                                </span>
                            </div>

                            <div class="low-sec">
                                <h6>FULLY 3D PRINTED HANDS WITH MULTI-PURPOSE USE.</h6>
                                <h6>APPEALING, UNIQUE, AND PRACTICAL </h6>
                                <h6>- LIMITED AMOUNT AVAILABLE -</h6>
                            </div>

                            <div class="second-model-title">
                                <h3>HANDS COLLECTION</h3>
                                <h6>3D Model #2 | To Be Announced</h6>                      
                            </div>
    
                        </div>

                    </div>

                </section>

                <div class="fourth-margin"></div>

                <section class="roadmap-page" id="roadmap">
                    <div class="product-wrapper">

                        <div id="roadmap" class="">

                            <div class="cover">
                                <div class="coverstick"></div>
                            </div>

                            <div class="split">
                                <dib class="hSplit"></dib>
                            </div>

                        </div>

                    </div>
                </section>

            </div>
        </div>

        
        <script src="../js/vanilla-tilt.js"></script>
        <script src="../js/htmlscripts.js"></script>
        <!-- <script src="../script.js"></script> -->
        <!-- <script src="../store.js"></script> -->
        
    </body>

</html>
